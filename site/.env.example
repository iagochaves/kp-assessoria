# Leads vão para o Netlify Forms (form "lead") e a função netlify/functions/lead-to-n8n.mts repassa ao n8n.
# A URL do n8n é N8N_WEBHOOK_URL, configurada na UI do Netlify (escopo Functions), não aqui. Ver netlify.toml.

# Container do GTM (Meta Pixel PageView/Lead para MQL + Microsoft Clarity). Só carrega no build de produção.
PUBLIC_GTM_ID=GTM-MG2NW6DJ

# Pixel da Meta do beacon de PageView inline (src/layouts/Base.astro). Mesmo pixel do container; só vale junto com o GTM.
PUBLIC_META_PIXEL_ID=3785399351716268

# Domínio onde esta landing roda (canonical e og:url). Variável de build, sem prefixo PUBLIC_.
# Ex.: SITE_URL=https://diagnostico.assessoriakp.com.br
SITE_URL=https://assessoriakp.com.br
