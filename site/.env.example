# Webhook do n8n que recebe o lead (mesmo endpoint do formulário Elementor do WordPress).
# Corpo form-urlencoded com os labels do Elementor como chave: ver src/lib/lead.ts.
# Obrigatório antes de publicar: sem ele o formulário mostra erro ao enviar.
PUBLIC_LEAD_ENDPOINT=https://kpadm-n8n.a6hrr3.easypanel.host/webhook/0f7d41ea-76e5-4c56-b1ad-078b867e1c1c

# Container do GTM (Meta Pixel PageView/Lead para MQL + Microsoft Clarity). Só carrega no build de produção.
PUBLIC_GTM_ID=GTM-NPXMNQSL

# Domínio onde esta landing roda (canonical e og:url). Variável de build, sem prefixo PUBLIC_.
# Ex.: SITE_URL=https://diagnostico.assessoriakp.com.br
SITE_URL=https://assessoriakp.com.br
