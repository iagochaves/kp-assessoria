---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Target and text of the skip link. */
  skip?: { href: string; label: string };
  /** Extra schema.org nodes for this page (e.g. FAQPage), added to the shared @graph. */
  schema?: Record<string, unknown>[];
}
const { title, description, noindex = false, skip = { href: '#quiz', label: 'Pular para o diagnóstico' }, schema = [] } = Astro.props;
/** LP container (gtm/container.json): Meta PageView on Initialization, Lead on kp_lead, Clarity after load. Off in dev so tests do not pollute the data. */
const gtmId = import.meta.env.PROD ? import.meta.env.PUBLIC_GTM_ID : '';
/** Same pixel as the container's Meta tags (gtm/container.json, "Const - Meta Pixel ID"). */
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID ?? '';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
const org = {
  '@type': 'ProfessionalService',
  '@id': new URL('/#org', Astro.site).toString(),
  name: 'KP Assessoria',
  legalName: 'Assessoria KP',
  taxID: '52.161.498/0001-78',
  url: Astro.site?.toString(),
  logo: new URL('/icon-512.png', Astro.site).toString(),
  image: ogImage.toString(),
  description: 'Assessoria de marketing e vendas para lojas de motos, carros e caminhões.',
  areaServed: { '@type': 'Country', name: 'Brasil' },
  telephone: '+55 31 97224-6252',
  sameAs: ['https://www.instagram.com/kpassessoria/'],
};
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {/* The Meta PageView is what turns an ad click into a landing page view, so it goes out as a plain image
      beacon while the head is parsed: no script to download or run. Its event id is kept in kpPageViewId so the
      GTM PageView tag can send the same id and Meta deduplicates the two.
      GTM (and with it fbevents.js, the Meta config and Clarity, about 400 KB of JS) only loads after window load
      and the first paint, so it never competes with the first render. When it ran before the paint, mobile
      Lighthouse counted those downloads in FCP/LCP and swung between 66 and 100. */}
  {gtmId && <script is:inline define:vars={{ gtmId, pixelId }}>(function(w,d){
    var c=w.crypto,e=c&&c.randomUUID?c.randomUUID():Date.now()+'.'+Math.random().toString(36).slice(2);
    w.kpPageViewId=e;
    if(pixelId){new Image().src='https://www.facebook.com/tr/?id='+pixelId+'&ev=PageView&eid='+encodeURIComponent(e)+'&dl='+encodeURIComponent(location.href)+'&rl='+encodeURIComponent(d.referrer)+'&ts='+Date.now();}
    w.dataLayer=w.dataLayer||[];
    var done=0;
    function gtm(){if(done++)return;w.dataLayer.push({'gtm.start':Date.now(),event:'gtm.js'});var j=d.createElement('script');j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+gtmId;d.head.appendChild(j);}
    // Window load can come before the first paint (Chrome may hold the first frame), so also wait for it.
    // A background tab never paints: the timeout still loads GTM there, so the Lead tag is always ready.
    function painted(){setTimeout(gtm,4000);try{var o=new PerformanceObserver(function(l){if(l.getEntriesByName('first-contentful-paint').length){o.disconnect();setTimeout(gtm,0);}});o.observe({type:'paint',buffered:true});}catch(_){gtm();}}
    if(d.readyState==='complete')painted();else w.addEventListener('load',painted,{once:true});
  })(window,document);</script>}
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#160038" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preload" href="/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="KP Assessoria" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="KP Assessoria: sua loja vendendo mais veículos, todo mês" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': [org, ...schema] })} />
</head>
<body>
  {gtmId && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="GTM"></iframe></noscript>}
  <a class="skip" href={skip.href}>{skip.label}</a>
  <slot />
</body>
</html>
