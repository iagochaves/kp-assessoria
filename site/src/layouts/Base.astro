---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Target and text of the skip link. */
  skip?: { href: string; label: string };
  /** Extra schema.org nodes for this page (e.g. FAQPage), added to the shared @graph. */
  schema?: Record<string, unknown>[];
}
const { title, description, noindex = false, skip = { href: '#quiz', label: 'Pular para o diagnóstico' }, schema = [] } = Astro.props;
/** LP container (gtm/container.json): Meta PageView on Initialization, Lead on kp_lead, Clarity after load. Off in dev so tests do not pollute the data. */
const gtmId = import.meta.env.PROD ? import.meta.env.PUBLIC_GTM_ID : '';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
const org = {
  '@type': 'ProfessionalService',
  '@id': new URL('/#org', Astro.site).toString(),
  name: 'KP Assessoria',
  legalName: 'Assessoria KP',
  taxID: '52.161.498/0001-78',
  url: Astro.site?.toString(),
  logo: new URL('/icon-512.png', Astro.site).toString(),
  image: ogImage.toString(),
  description: 'Assessoria de marketing e vendas para lojas de motos, carros e caminhões.',
  areaServed: { '@type': 'Country', name: 'Brasil' },
  telephone: '+55 31 97224-6252',
  sameAs: ['https://www.instagram.com/kpassessoria/'],
};
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {/* GTM starts downloading while the head is parsed: the Meta PageView (Initialization trigger) is what turns
      an ad click into a landing page view, and every second of delay loses the visitors who leave early.
      Clarity waits for window load inside the container, so it never competes with the first render. */}
  {gtmId && <link rel="preconnect" href="https://www.googletagmanager.com" />}
  {/* The Meta tag in GTM injects fbevents.js only after gtm.js arrives; preloading it overlaps the two
      downloads (same URL and no crossorigin, so GTM's script reuses the preloaded copy). */}
  {gtmId && <link rel="preload" href="https://connect.facebook.net/en_US/fbevents.js" as="script" />}
  {gtmId && <script is:inline define:vars={{ gtmId }}>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);</script>}
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#160038" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preload" href="/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="KP Assessoria" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="KP Assessoria: sua loja vendendo mais veículos, todo mês" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': [org, ...schema] })} />
</head>
<body>
  {gtmId && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="GTM"></iframe></noscript>}
  <a class="skip" href={skip.href}>{skip.label}</a>
  <slot />
</body>
</html>
