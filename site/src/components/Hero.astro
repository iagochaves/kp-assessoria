---
import { Image } from 'astro:assets';
import logo from '../assets/kp-monogram-white.png';
import { segments, brackets, roles, testimonials, numbers } from '../data/content';

const byId = Object.fromEntries(testimonials.map((t) => [t.id, t]));
/** One proof card per lead/also pair; each lists the segment:bracket-index answers that reveal it. */
const cards = new Map<string, { lead: string; also: string; keys: string[] }>();
for (const seg of segments) brackets[seg.id].forEach((b, i) => {
  const k = `${b.lead}-${b.also}`;
  if (!cards.has(k)) cards.set(k, { lead: b.lead, also: b.also, keys: [] });
  cards.get(k)!.keys.push(`${seg.id}:${i}`);
});
const endpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT ?? '';
if (!endpoint) console.warn('[kp] PUBLIC_LEAD_ENDPOINT não definido: o formulário vai exibir erro ao enviar.');
const check = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.5" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>';
---
<header class="hero" id="topo">
  <div class="wrap">
    <div class="top">
      <Image src={logo} alt="KP Assessoria" width={124} loading="eager" />
      <p class="stat num">Lojas assessoradas faturam<br /><b>+{numbers.revenue} por mês</b></p>
    </div>

    <div class="hero-grid">
      <div class="intro">
        <h1>Sua loja vendendo <em>mais veículos</em>, todo mês.</h1>
        <p class="lede">Para lojas de motos, carros e caminhões: campanha que traz comprador, time comercial treinado para fechar e alguém da KP acompanhando os números com você. <b>Faça o diagnóstico</b> e veja o que lojas parceiras conseguiram.</p>
      </div>

      <div class="quiz-slot" id="quiz">
      <!-- id MQL/TOP and the form-field-* input ids are read by the live GTM container (Meta Lead tag); see src/lib/lead.ts. -->
      <form class="quiz" id="TOP" data-lead-type="TOP" novalidate aria-label="Diagnóstico da sua loja" data-endpoint={endpoint} data-segments={JSON.stringify(Object.fromEntries(segments.map((g) => [g.id, g.value])))}>
        <div class="q-progress">
          <span id="qStepTxt" aria-live="polite">Passo <b>1</b> de 4 · menos de 30 segundos</span>
          <span class="bar" aria-hidden="true"><i id="qBar"></i></span>
        </div>

        <fieldset class="step on" data-step="1" data-name="segmento">
          <legend class="q-title">O que sua loja vende?</legend>
          <div class="rows" role="radiogroup" aria-label="Segmento">
            {segments.map((g) => <button type="button" class="row" role="radio" aria-checked="false" data-v={g.id}>{g.label}</button>)}
          </div>
        </fieldset>

        <fieldset class="step" data-step="2" data-name="faixa">
          <legend class="q-title" id="volQ">{segments[0].q}</legend>
          <p class="q-hint" id="volHint">Somando à vista e financiado.</p>
          {segments.map((g, i) => (
            <div class="vol" data-seg={g.id} data-q={g.q} data-hint={g.kind === 'volume' ? 'Somando à vista e financiado.' : 'Faturamento bruto aproximado.'} hidden={i > 0}>
              {g.kind === 'volume' ? (
                <div class="tiles" role="radiogroup" aria-label={`${g.label} por mês`}>
                  {brackets[g.id].map((b, j) => (
                    <button type="button" class="tile" role="radio" aria-checked="false" data-v={b.value} data-i={j}>
                      <span class="tick" set:html={check} />
                      <span class={j === 0 ? 'n num new' : 'n num'}>{b.label}</span>
                      <span class="u">{j === 0 ? 'loja ainda não abriu' : g.unit}</span>
                    </button>
                  ))}
                </div>
              ) : (
                <div class="rows" role="radiogroup" aria-label="Faturamento mensal">
                  {brackets[g.id].map((b, j) => <button type="button" class="row num" role="radio" aria-checked="false" data-v={b.value} data-i={j}>{b.label}</button>)}
                </div>
              )}
            </div>
          ))}
          <div class="q-actions"><button type="button" class="back" data-prev>Voltar</button></div>
        </fieldset>

        <fieldset class="step" data-step="3" data-name="cargo">
          <legend class="q-title">Qual é o seu papel na loja?</legend>
          <div class="rows" role="radiogroup" aria-label="Cargo">
            {roles.map((r) => <button type="button" class="row" role="radio" aria-checked="false" data-v={r.value}>{r.label}</button>)}
          </div>
          <div class="q-actions"><button type="button" class="back" data-prev>Voltar</button></div>
        </fieldset>

        <fieldset class="step" data-step="4">
          <legend class="q-title">Falta pouco. Para onde ligamos?</legend>
          <p class="q-hint">Um especialista fala com você em até 8 horas úteis.</p>
          <div class="fields">
            <div class="field"><label for="form-field-name">Seu nome</label><input id="form-field-name" name="nome" autocomplete="name" required placeholder="Ex.: João Silva" /><p class="err" id="e-nome">Digite seu nome.</p></div>
            <div class="field"><label for="form-field-field_d2afb88">WhatsApp com DDD</label><input id="form-field-field_d2afb88" name="whatsapp" type="tel" inputmode="tel" autocomplete="tel-national" required placeholder="(00) 00000-0000" /><p class="err" id="e-tel">Digite um WhatsApp com DDD, como (31) 99999-9999.</p></div>
            <div class="field"><label for="form-field-message">Nome da loja</label><input id="form-field-message" name="loja" autocomplete="organization" required placeholder="Ex.: Silva Veículos" /><p class="err" id="e-loja">Digite o nome da loja.</p></div>
            <div class="field"><label for="form-field-email">Seu melhor e-mail</label><input id="form-field-email" name="email" type="email" autocomplete="email" required placeholder="voce@sualoja.com.br" /><p class="err" id="e-email">Digite um e-mail válido, como voce@sualoja.com.br.</p></div>
            <!-- Honeypot with a name no autofill recognizes: "empresa_site" read as a company field to
                 Chrome and Safari autofill, which filled it for real people, and their leads were dropped as bots. -->
            <input class="hp" name="kp_hp" tabindex="-1" autocomplete="off" aria-hidden="true" data-lpignore="true" data-1p-ignore="true" data-bwignore="true" data-form-type="other" />
          </div>
          <p class="send-err" id="sendErr" role="alert" hidden>Não conseguimos registrar seu pedido agora. Suas respostas continuam aqui: tente de novo em alguns instantes.</p>
          <!-- type="button": the native submit event (which fires the GTM Lead tag) is only dispatched after validation passes. -->
          <div class="q-actions"><button type="button" class="back" data-prev>Voltar</button><button type="button" class="btn grow" id="submitBtn">Pedir diagnóstico</button></div>
        </fieldset>

        <div class="step" data-step="5" role="status" tabindex="-1">
          <p class="q-title">Recebemos. Agora é com a gente.</p>
          <p class="q-hint done">Um especialista da KP vai chamar no seu WhatsApp em até 8 horas úteis para entender o momento da loja.</p>
        </div>

        <p class="q-foot"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>Sem spam. Seus dados ficam só com a KP.</p>
      </form>
      </div>

      <div class="proof" id="proof" aria-live="polite">
        <div class="proof-empty">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h4l3 8 4-16 3 8h4"/></svg>
          <span>Diga o que sua loja vende e quanto vende por mês. Mostramos aqui o resultado de uma loja parceira.</span>
        </div>
        {[...cards.values()].map((c) => {
          const t = byId[c.lead];
          const o = byId[c.also];
          return (
            <article class="proof-card" data-for={c.keys.join(' ')} hidden>
              <div class="proof-video">
                <Image src={t.poster} alt={`${t.name}, ${t.store}`} widths={[200, 400]} sizes="(min-width: 560px) 150px, 100vw" loading="lazy" />
                {t.video && (
                  <button type="button" class="play" data-video={t.video} aria-label={`Assistir depoimento de ${t.name}`}>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                  </button>
                )}
              </div>
              <div class="proof-body">
                <p class="proof-big num">{t.big}<small>{t.sub}</small></p>
                <p class="proof-quote" set:html={t.quote} />
                <p class="proof-who">{t.name} <span>| {t.store}</span></p>
                <p class="proof-more num">{o.store}: <b>{o.big}</b> {o.sub}.</p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</header>

<style>
  .hero { position: relative; isolation: isolate; background: var(--night); overflow: hidden; padding-bottom: clamp(40px, 7vw, 96px); }
  .hero::before { content: ""; position: absolute; inset: -20% -10% auto auto; width: min(900px, 120vw); aspect-ratio: 1; z-index: -1;
    background: radial-gradient(closest-side, rgb(122 47 241 / .55), rgb(92 16 216 / .18) 55%, transparent 72%); }
  .hero::after { content: ""; position: absolute; inset: auto auto -30% -20%; width: min(700px, 100vw); aspect-ratio: 1; z-index: -1;
    background: radial-gradient(closest-side, rgb(157 92 255 / .22), transparent 70%); }

  .top { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 18px; }
  .top img { width: 124px; height: auto; }
  .stat { font-size: .8125rem; line-height: 1.3; color: var(--text-soft); text-align: right; }
  .stat b { color: var(--white); font-family: var(--font-112); font-stretch: 112%; }

  .hero-grid { display: grid; gap: clamp(28px, 4vw, 56px); grid-template-columns: 1fr; padding-top: clamp(8px, 3vw, 40px); }
  @media (min-width: 980px) {
    .hero-grid { grid-template-columns: 1.05fr 1fr; grid-template-areas: "intro quiz" "proof quiz"; align-items: start; row-gap: 32px; }
    .intro { grid-area: intro; } .quiz-slot { grid-area: quiz; } .proof { grid-area: proof; }
  }
  .lede { margin-top: 20px; max-width: 26.3em; font-size: clamp(1.05rem, 1.6vw, 1.2rem); color: var(--text-soft); }
  .lede b { color: var(--white); }

  .quiz { position: relative; background: linear-gradient(180deg, rgb(74 27 151 / .55), rgb(26 1 71 / .9)); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: clamp(20px, 3vw, 32px); box-shadow: 0 30px 60px -20px rgb(0 0 0 / .55); }
  .quiz-slot { scroll-margin-top: 16px; }
  .q-progress { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: .8125rem; color: var(--text-soft); margin-bottom: 18px; }
  .q-progress b { color: var(--white); }
  .bar { flex: 1; height: 4px; border-radius: 4px; background: rgb(203 179 255 / .15); overflow: hidden; max-width: 160px; }
  .bar i { display: block; height: 100%; width: 100%; transform: scaleX(.25); transform-origin: left; background: var(--glow); border-radius: inherit; transition: transform .6s var(--ease); }
  .q-title { font-size: clamp(1.35rem, 2.6vw, 1.75rem); line-height: 1.15; font-weight: 700; letter-spacing: -.02em; font-family: var(--font-108); font-stretch: 108%; text-wrap: balance; }
  .q-title:focus { outline: none; }
  .q-hint { margin-top: 6px; font-size: .9375rem; color: var(--text-soft); }
  .q-hint.done { margin-top: 10px; }

  .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 20px; }
  .tile { position: relative; appearance: none; border: 1px solid rgb(203 179 255 / .28); background: rgb(22 0 56 / .65); color: var(--white);
    border-radius: var(--r-md); padding: 16px 16px 14px; text-align: left; cursor: pointer; min-height: 104px;
    display: flex; flex-direction: column; justify-content: space-between;
    transition: border-color .25s var(--ease), background .25s var(--ease), transform .25s var(--ease), box-shadow .35s var(--ease); }
  .tile .n { font-size: clamp(1.7rem, 4.2vw, 2.3rem); line-height: 1; font-weight: 800; letter-spacing: -.02em; font-family: var(--font-125); font-stretch: 125%; white-space: nowrap; padding-right: 22px; }
  .tile .n.new { font-size: clamp(1.15rem, 3vw, 1.45rem); }
  .tile .u { font-size: .875rem; color: var(--text-soft); }
  .tile:hover { border-color: var(--glow); background: rgb(74 27 151 / .55); }
  .tile:active { transform: scale(.98); }
  .tile[aria-checked="true"] { border-color: var(--glow); background: rgb(157 92 255 / .16); box-shadow: 0 12px 30px -10px rgb(157 92 255 / .55); }
  .tile[aria-checked="true"] .n { color: var(--glow); }
  .tick { position: absolute; top: 12px; right: 12px; width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid rgb(203 179 255 / .4); display: grid; place-items: center; transition: .25s var(--ease); }
  .tile[aria-checked="true"] .tick { background: var(--glow); border-color: var(--glow); }
  .tick :global(svg) { opacity: 0; transition: opacity .2s; }
  .tile[aria-checked="true"] .tick :global(svg) { opacity: 1; }

  .rows { display: grid; gap: 10px; margin-top: 20px; }
  .row { appearance: none; text-align: left; cursor: pointer; min-height: 56px; padding: 14px 16px; border-radius: var(--r-md);
    border: 1px solid rgb(203 179 255 / .28); background: rgb(22 0 56 / .65); font-weight: 600;
    transition: border-color .2s var(--ease), background .2s var(--ease); }
  .row:hover { border-color: var(--glow); }
  .row[aria-checked="true"] { border-color: var(--glow); background: rgb(157 92 255 / .16); }

  /* Pick feedback: press-and-settle plus a glow ring, short enough to finish before the auto-advance. */
  .row { position: relative; }
  .tile.picked, .row.picked { animation: pick .3s var(--ease); }
  .tile.picked::after, .row.picked::after { content: ""; position: absolute; inset: -1px; border-radius: inherit; border: 2px solid var(--glow);
    pointer-events: none; animation: ring .3s var(--ease) forwards; }
  .tile.picked .tick { animation: tickPop .3s var(--ease); }
  @keyframes pick { 30% { transform: scale(.97); } 65% { transform: scale(1.015); } }
  @keyframes ring { from { opacity: .9; } to { opacity: 0; transform: scale(1.05); } }
  @keyframes tickPop { from { transform: scale(.4); } 60% { transform: scale(1.2); } }

  .fields { display: grid; gap: 12px; margin-top: 20px; }
  .field label { display: block; font-size: .875rem; font-weight: 600; margin-bottom: 6px; }
  .field .opt { font-weight: 400; color: var(--text-soft); }
  .field input { width: 100%; font: inherit; font-size: 16px; color: var(--graphite); background: var(--white); border: 1px solid var(--mist); border-radius: var(--r-sm); padding: 14px; min-height: 50px; }
  .field input:focus { outline: 2px solid var(--lilac); outline-offset: 2px; border-color: var(--glow); }
  .field input[aria-invalid="true"] { border-color: var(--error); box-shadow: 0 0 0 1px var(--error); }
  .field input::placeholder { color: #6b6478; }
  .err { display: none; margin-top: 6px; font-size: .8125rem; color: var(--error); }
  .field input[aria-invalid="true"] + .err { display: block; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .send-err { margin-top: 14px; font-size: .875rem; color: var(--error); }

  .q-actions { display: flex; align-items: center; gap: 12px; margin-top: 20px; }
  .q-actions :global(.full) { width: 100%; }
  .q-actions :global(.grow) { flex: 1; }
  .q-actions :global(.btn) { padding-inline: 18px; white-space: nowrap; }
  .back { appearance: none; background: none; border: 0; color: var(--text-soft); font-size: .9375rem; cursor: pointer; padding: 12px 6px; min-height: 48px; text-decoration: underline; text-underline-offset: .25em; }
  .step { display: none; }
  .step.on { display: block; animation: stepIn .45s var(--ease) both; }
  @keyframes stepIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .q-foot { margin-top: 14px; font-size: .8125rem; color: var(--text-soft); display: flex; gap: 8px; align-items: center; }
  .q-foot svg { flex: none; }

  /* Proof reveal: the authored moment */
  .proof-empty { border: 1px dashed rgb(203 179 255 / .3); border-radius: var(--r-lg); padding: 22px; color: var(--text-soft); font-size: .9375rem; display: flex; gap: 14px; align-items: center; }
  .proof-empty svg { flex: none; color: var(--glow); }
  .proof.on .proof-empty { display: none; }
  .proof-card { border-radius: var(--r-lg); background: var(--paper); color: var(--graphite); overflow: hidden; box-shadow: 0 30px 60px -24px rgb(0 0 0 / .6);
    display: grid; grid-template-columns: 1fr; animation: reveal .8s var(--ease) both; }
  .proof-card[hidden] { display: none; }
  @media (min-width: 560px) { .proof-card { grid-template-columns: 150px 1fr; } }
  @keyframes reveal { from { clip-path: inset(0 0 100% 0 round 16px); filter: blur(6px); } to { clip-path: inset(0 0 0 0 round 16px); filter: blur(0); } }
  .proof-video { position: relative; background: var(--deep); min-height: 220px; display: grid; place-items: center; overflow: hidden; }
  .proof-video :global(img), .proof-video :global(video) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .play { position: relative; z-index: 1; width: 56px; height: 56px; border-radius: 50%; color: var(--white); background: rgb(22 0 56 / .45); border: 1px solid rgb(255 255 255 / .55);
    display: grid; place-items: center; cursor: pointer; backdrop-filter: blur(4px); transition: transform .2s var(--ease), background .2s; }
  .play:hover { transform: scale(1.06); background: rgb(157 92 255 / .6); }
  .proof-body { padding: 20px 22px 22px; }
  .proof-big { font-size: clamp(2.2rem, 5vw, 3rem); line-height: 1; font-weight: 800; letter-spacing: -.025em; color: var(--royal); font-family: var(--font-125); font-stretch: 125%; }
  .proof-big small { display: block; font-size: .9375rem; letter-spacing: 0; font-weight: 600; color: var(--graphite); margin-top: 6px; font-family: var(--font); font-stretch: 100%; }
  .proof-quote { margin-top: 12px; line-height: 1.5; max-width: 29.8em; }
  .proof-who { margin-top: 12px; font-size: .875rem; font-weight: 700; color: var(--royal); }
  .proof-who span { font-weight: 400; color: var(--text-on-light-soft); }
  .proof-more { margin-top: 12px; font-size: .875rem; color: var(--text-on-light-soft); border-top: 1px solid #e4e0ea; padding-top: 12px; }
  .proof-more b { color: var(--graphite); }
</style>

<script>
  import { buildBody, classify, emailOk, leadType, nationalDigits, type LeadInput } from '../lib/lead';

  const form = document.querySelector<HTMLFormElement>('#quiz form')!;
  const steps = [...form.querySelectorAll<HTMLElement>('.step')];
  const bar = document.getElementById('qBar')!;
  const stepTxt = document.getElementById('qStepTxt')!;
  const proof = document.getElementById('proof')!;
  const answers: Record<string, string> = {};
  const LAST = steps.length - 1;
  const volStep = form.querySelector<HTMLElement>('[data-name="faixa"]')!;
  const segValue: Record<string, string> = JSON.parse(form.dataset.segments!);
  let cur = 0;
  /** Pending auto-advance after an option click; non-null blocks further clicks until it fires. */
  let advance: number | null = null;
  const ADVANCE_MS = 300;

  const go = (i: number) => {
    if (advance !== null) { clearTimeout(advance); advance = null; }
    steps[cur].classList.remove('on');
    cur = i;
    steps[cur].classList.add('on');
    const n = Math.min(cur + 1, LAST);
    bar.style.transform = `scaleX(${cur >= LAST ? 1 : n / LAST})`;
    stepTxt.innerHTML = cur >= LAST ? '<b>Pronto</b>' : `Passo <b>${n}</b> de ${LAST} · ${cur === LAST - 1 ? 'falta pouco' : 'menos de 30 segundos'}`;
    // Returning to an answered step lands on the answer already given.
    const scope = steps[cur].querySelector<HTMLElement>('.vol:not([hidden])') ?? steps[cur];
    const target = cur >= LAST ? steps[cur] : scope.querySelector<HTMLElement>('[aria-checked="true"]') ?? scope.querySelector<HTMLElement>('[role=radio],input');
    if (target && cur) target.focus({ preventScroll: true });
  };

  const field = (id: string) => document.getElementById(id) as HTMLInputElement;
  const lead = (): LeadInput => ({
    segment: answers.segmento as LeadInput['segment'],
    venda: segValue[answers.segmento] ?? '',
    faixa: answers.faixa ?? '',
    cargo: answers.cargo ?? '',
    nome: field('form-field-name').value,
    email: field('form-field-email').value,
    telefone: field('form-field-field_d2afb88').value,
    empresa: field('form-field-message').value,
    search: location.search,
    pageUrl: location.href,
  });

  /** Same contract as the WordPress popup script: the GTM Lead tag fires when the form id contains "MQL". */
  function classifyForm() {
    const c = classify(buildBody(lead()));
    const t = leadType(c);
    form.id = t;
    form.dataset.leadType = t;
    form.dataset.leadClass = c;
    return { c, t };
  }

  function track(event: string) {
    const { c, t } = classifyForm();
    const w = window as unknown as { dataLayer?: object[] };
    (w.dataLayer ??= []).push({
      event, clickId: t, formId: t, leadType: t, lead_type: t, isMQL: t === 'MQL', lead_class: c,
      segmento: segValue[answers.segmento] ?? '',
    });
  }

  form.querySelectorAll<HTMLElement>('[role=radiogroup]').forEach((g) => {
    const step = g.closest<HTMLElement>('.step')!;
    const opts = [...g.querySelectorAll<HTMLElement>('[role=radio]')];
    const select = (o: HTMLElement) => {
      opts.forEach((x) => { x.setAttribute('aria-checked', String(x === o)); x.tabIndex = x === o ? 0 : -1; });
      o.classList.remove('picked'); void o.offsetWidth; o.classList.add('picked');
      answers[step.dataset.name!] = o.dataset.v!;
      if (step === volStep) showProof(`${answers.segmento}:${o.dataset.i}`);
      else if (step.dataset.name === 'segmento') pickSegment(o.dataset.v!);
      classifyForm();
    };
    opts.forEach((o, i) => {
      o.tabIndex = i === 0 ? 0 : -1;
      // Drop the class once played so re-showing the step doesn't replay it.
      const unpick = (e: AnimationEvent) => { if (e.target === o) o.classList.remove('picked'); };
      o.addEventListener('animationend', unpick);
      o.addEventListener('animationcancel', unpick); // the step can hide mid-animation
      // Click, Enter and Space pick and move on, like the old LP; arrow keys only move the selection.
      o.addEventListener('click', () => {
        if (advance !== null) return;
        select(o);
        const next = steps.indexOf(step) + 1;
        advance = window.setTimeout(() => { advance = null; go(next); }, ADVANCE_MS);
      });
      o.addEventListener('keydown', (e) => {
        const k = e.key;
        if (!['ArrowDown', 'ArrowRight', 'ArrowUp', 'ArrowLeft'].includes(k)) return;
        e.preventDefault();
        const d = k === 'ArrowDown' || k === 'ArrowRight' ? 1 : -1;
        const nx = opts[(i + d + opts.length) % opts.length];
        nx.focus(); select(nx);
      });
    });
  });

  function pickSegment(seg: string) {
    volStep.querySelectorAll<HTMLElement>('.vol').forEach((v) => {
      v.hidden = v.dataset.seg !== seg;
      if (!v.hidden) {
        document.getElementById('volQ')!.textContent = v.dataset.q!;
        document.getElementById('volHint')!.textContent = v.dataset.hint!;
      }
    });
    volStep.querySelectorAll<HTMLElement>('.vol').forEach((v) => v.querySelectorAll<HTMLElement>('[role=radio]').forEach((x, i) => {
      x.setAttribute('aria-checked', 'false'); x.tabIndex = i === 0 ? 0 : -1;
    }));
    delete answers.faixa;
    proof.classList.remove('on');
    proof.querySelectorAll<HTMLElement>('.proof-card').forEach((c) => { c.hidden = true; });
  }
  function showProof(key: string) {
    proof.classList.add('on');
    proof.querySelectorAll<HTMLElement>('.proof-card').forEach((c) => {
      const on = c.dataset.for!.split(' ').includes(key);
      if (on) { c.hidden = false; c.style.animation = 'none'; void c.offsetWidth; c.style.animation = ''; }
      else c.hidden = true;
    });
  }

  form.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-prev]')) go(cur - 1);
  });

  const digits = (s: string) => s.replace(/\D/g, '');
  const tel = field('form-field-field_d2afb88');
  tel.addEventListener('input', () => {
    const d = nationalDigits(tel.value);
    tel.value = d.length > 6 ? `(${d.slice(0, 2)}) ${d.slice(2, d.length - 4)}-${d.slice(-4)}` : d.length > 2 ? `(${d.slice(0, 2)}) ${d.slice(2)}` : d;
  });

  const btn = document.getElementById('submitBtn') as HTMLButtonElement;
  const sendErr = document.getElementById('sendErr')!;
  let sending = false;

  /** Validates, then dispatches the native submit event that GTM listens to (gtm.formSubmit). */
  function trySubmit() {
    if (sending) return;
    const email = field('form-field-email');
    const checks: [HTMLInputElement, boolean, string][] = [
      [field('form-field-name'), field('form-field-name').value.trim().length < 2, 'e-nome'],
      [tel, digits(tel.value).length < 10, 'e-tel'],
      [field('form-field-message'), field('form-field-message').value.trim().length < 2, 'e-loja'],
      [email, !emailOk(email.value) || !email.checkValidity(), 'e-email'],
    ];
    let first: HTMLInputElement | null = null;
    for (const [el, bad, errId] of checks) {
      el.setAttribute('aria-invalid', String(bad));
      if (bad) el.setAttribute('aria-describedby', errId); else el.removeAttribute('aria-describedby');
      if (bad && !first) first = el;
    }
    if (first) { first.focus(); return; }
    // Bots filling the honeypot see the success state without a lead or a Lead event.
    // kp_form_honeypot counts them in GTM: if it climbs, real people are being caught again.
    if (form.querySelector<HTMLInputElement>('.hp')!.value) { track('kp_form_honeypot'); go(LAST); return; }
    classifyForm();
    if (form.requestSubmit) form.requestSubmit();
    else form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
  }

  btn.addEventListener('pointerdown', () => track('kp_prepare_lead_click'));
  btn.addEventListener('click', trySubmit);
  steps[LAST - 1].addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && (e.target as HTMLElement).tagName === 'INPUT') { e.preventDefault(); trySubmit(); }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (sending) return;
    sending = true;
    track('kp_form_submit');
    sendErr.hidden = true;
    btn.setAttribute('aria-busy', 'true');
    btn.disabled = true;
    try {
      const endpoint = form.dataset.endpoint;
      if (!endpoint) throw new Error('PUBLIC_LEAD_ENDPOINT ausente');
      // Form-encoded like the Elementor webhook: a CORS "simple" request, no preflight.
      const res = await fetch(endpoint, { method: 'POST', body: new URLSearchParams(buildBody(lead())) });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      track('kp_form_submit_success');
      form.dataset.sent = 'true';
      go(LAST);
      location.assign('/obrigado/');
    } catch (err) {
      console.error('[kp] envio do lead falhou', err);
      sendErr.hidden = false;
      sending = false;
      btn.removeAttribute('aria-busy');
      btn.disabled = false;
    }
  });

  // Video loads only on tap (poster first).
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-video]');
    if (!b) return;
    const v = document.createElement('video');
    v.src = b.dataset.video!; v.controls = true; v.autoplay = true; v.playsInline = true; v.preload = 'auto';
    v.setAttribute('aria-label', b.getAttribute('aria-label') ?? 'Depoimento em vídeo');
    b.replaceWith(v);
    v.play().catch(() => {});
  });

  // One testimonial at a time: starting a video pauses the others.
  document.addEventListener('play', (e) => {
    document.querySelectorAll('video').forEach((o) => { if (o !== e.target) o.pause(); });
  }, true);
</script>
