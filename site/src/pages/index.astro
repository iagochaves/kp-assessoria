---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { testimonials, steps, faq, handles, numbers } from '../data/content';
import placa350 from '../assets/placa-350k.jpg';
import placa1m from '../assets/placa-1m.jpg';
import time from '../assets/time.jpg';
import logo from '../assets/kp-monogram-white.png';

const handleImgs = import.meta.glob<{ default: ImageMetadata }>('../assets/handles/*.png', { eager: true });
const chips = Object.keys(handleImgs).sort().map((k, i) => ({ img: handleImgs[k].default, handle: handles[i] }));

const plus = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>';
const tick = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>';
const playIcon = '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>';
---
<Base
  title="KP Assessoria · Marketing e vendas para lojas de veículos"
  description={`Assessoria de marketing e vendas para lojas de motos, carros e caminhões. Lojas assessoradas faturam mais de ${numbers.revenue} por mês. Faça o diagnóstico gratuito da sua loja.`}
>
  <Hero />

  <main>
    <div class="marquee" role="region" aria-label="Lojas parceiras no Instagram">
      <ul class="track">
        {[...chips, ...chips].map((c, i) => (
          <li aria-hidden={i >= chips.length ? 'true' : undefined}>
            <Image src={c.img} alt={i >= chips.length ? '' : `@${c.handle}`} width={175} height={66} loading="lazy" />
          </li>
        ))}
      </ul>
    </div>

    <section class="statement" aria-label="KP em números">
      <div class="wrap">
        <p class="num">Mais de <b>{numbers.companies} empresas</b> em todo o Brasil já foram assessoradas pela KP. Nossos clientes faturam <em>mais de {numbers.revenue} todos os meses</em>. Há <b>mais de {numbers.years} anos</b> fazendo isso para loja de veículo.</p>
      </div>
    </section>

    <section class="how sec" aria-labelledby="how-h">
      <div class="wrap">
        <h2 id="how-h">Do anúncio ao veículo saindo da loja.</h2>
        <p class="sec-lede">Aqui o foco não é clique ou curtida. Cuidamos do caminho inteiro até a venda, e medimos em veículos vendidos e em reais.</p>
        <ol class="steps">
          {steps.map((s) => <li class="st"><h3>{s.t}</h3><p set:html={s.d} /></li>)}
        </ol>
      </div>
    </section>

    <section class="placas sec" aria-labelledby="placas-h">
      <div class="wrap">
        <div class="placas-head">
          <h2 id="placas-h">Bateu a meta, a placa vai pra parede.</h2>
          <p class="sec-lede">Enquanto outras agências mostram relatórios, a KP reconhece os parceiros com <b>placas reais de faturamento</b>. Cada placa é uma loja de verdade.</p>
        </div>
        <div class="placas-grid">
          <figure class="foto">
            <Image src={placa350} alt="Parceiro da KP segurando a Placa de Faturamento 350K em frente à loja" widths={[361, 722]} sizes="(min-width: 560px) 360px, 100vw" loading="lazy" />
            <figcaption><strong class="num">350K</strong><span>Placa de Faturamento KP</span></figcaption>
          </figure>
          <figure class="foto">
            <Image src={placa1m} alt="Parceiro da KP segurando a Placa de Faturamento 1M ao lado de consultor da KP" widths={[361, 722]} sizes="(min-width: 560px) 360px, 100vw" loading="lazy" />
            <figcaption><strong class="num hi">1M</strong><span>Placa de Faturamento KP</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="dep sec" aria-labelledby="dep-h">
      <div class="wrap">
        <h2 id="dep-h">Quem fala são os donos.</h2>
        <p class="sec-lede">Alguns resultados de nossos parceiros.</p>
        <ul class="dep-rail" aria-label="Depoimentos">
          {testimonials.map((t) => (
            <li class="dv">
              <div class="poster">
                <Image src={t.poster} alt={`${t.name}, ${t.store}`} widths={[280, 560]} sizes="(min-width: 1100px) 220px, 78vw" loading="lazy" />
                {t.video && <button type="button" class="play" data-video={t.video} aria-label={`Assistir depoimento de ${t.name}, ${t.store}`} set:html={playIcon} />}
                <p class="big num">{t.big}<small>{t.sub}</small></p>
              </div>
              <div class="txt">
                <p set:html={t.quote} />
                <p class="who">{t.name} | {t.store}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="time sec" aria-labelledby="time-h">
      <div class="wrap time-grid">
        <div class="time-photo">
          <Image src={time} alt="Time da KP Assessoria de polo roxa, com parceiros segurando Placas de Faturamento" widths={[480, 860]} sizes="(min-width: 900px) 50vw, 100vw" loading="lazy" />
        </div>
        <div>
          <h2 id="time-h">Gente de roxo do lado da sua loja.</h2>
          <p class="sec-lede">A KP entra no ritmo do comércio e fala a mesma língua que você.</p>
          <ul class="promise">
            <li><span set:html={tick} /><p><b>Sem hora pra sair, sem final de semana, sem feriado.</b> Acompanhamento de perto.</p></li>
            <li><span set:html={tick} /><p><b>Time comercial treinado</b> para transformar lead em venda fechada.</p></li>
            <li><span set:html={tick} /><p><b>Nem sempre temos vagas abertas.</b> O trabalho é exclusivo.</p></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="faq sec" aria-labelledby="faq-h">
      <div class="wrap faq-grid">
        <h2 id="faq-h">O que todo dono pergunta antes.</h2>
        <div>
          {faq.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}<span set:html={plus} /></summary>
              <p class="a" set:html={f.a} />
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="close" aria-labelledby="close-h">
      <div class="wrap">
        <h2 id="close-h">Quantos veículos você quer vender <em>no próximo mês?</em></h2>
        <p>Leva menos de 30 segundos. Um especialista chama você em até 8 horas úteis.</p>
        <div class="ctas"><a class="btn" href="#quiz">Fazer o diagnóstico</a></div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <Image src={logo} alt="KP Assessoria" width={96} loading="lazy" />
      <p class="num">Assessoria KP · CNPJ 52.161.498/0001-78 · © {new Date().getFullYear()}</p>
      <a href="#topo">Voltar para o topo</a>
    </div>
  </footer>

  <div class="dock" id="dock"><a class="btn" href="#quiz">Fazer o diagnóstico da loja</a></div>
</Base>

<style>
  .marquee { background: var(--band); padding-block: 14px; overflow: hidden;
    mask-image: linear-gradient(to right, transparent 0, #000 60px, #000 calc(100% - 60px), transparent 100%); }
  .track { display: flex; gap: 12px; width: max-content; animation: slide 60s linear infinite; }
  .track li { flex: none; }
  .track :global(img) { width: 175px; height: 66px; border-radius: 12px; }
  .marquee:hover .track { animation-play-state: paused; }
  @keyframes slide { to { transform: translateX(calc(-50% - 6px)); } }

  .statement { background: var(--night); padding-block: clamp(64px, 10vw, 128px); }
  .statement p { font-size: clamp(1.6rem, 4.6vw, 4rem); line-height: 1.08; font-weight: 600; letter-spacing: -.025em; font-stretch: 112%; max-width: 27ch; text-wrap: balance; color: var(--text-soft); }
  .statement b { color: var(--white); font-weight: 800; }
  .statement em { font-style: normal; color: var(--glow); font-weight: 800; }

  .how { background: var(--ink); }
  .steps { margin-top: clamp(40px, 6vw, 72px); display: grid; counter-reset: s; }
  @media (min-width: 900px) { .steps { grid-template-columns: repeat(4, 1fr); } }
  .st { position: relative; padding: 0 0 36px 52px; }
  .st::before { counter-increment: s; content: counter(s); position: absolute; left: 0; top: 0; width: 34px; height: 34px; border-radius: 50%;
    display: grid; place-items: center; font-weight: 800; font-size: .9375rem; background: var(--night); border: 1.5px solid var(--glow); font-variant-numeric: tabular-nums; }
  .st::after { content: ""; position: absolute; left: 17px; top: 38px; bottom: 4px; width: 1px; background: linear-gradient(var(--glow), rgb(157 92 255 / .1)); }
  .st:last-child::after { display: none; }
  @media (min-width: 900px) {
    .st { padding: 56px 28px 0 0; }
    .st::after { left: 40px; right: 0; top: 17px; bottom: auto; width: auto; height: 1px; background: linear-gradient(90deg, var(--glow), rgb(157 92 255 / .1)); }
  }
  .st h3 { font-size: 1.25rem; line-height: 1.2; font-weight: 700; letter-spacing: -.015em; font-stretch: 108%; text-wrap: balance; }
  .st p { margin-top: 8px; color: var(--text-soft); max-width: 34ch; }
  .st p :global(b) { color: var(--white); }

  .placas { background: var(--paper); color: var(--graphite); }
  .placas h2 { color: var(--navy); }
  .placas .sec-lede { color: var(--text-on-light-soft); }
  .placas-grid { margin-top: clamp(40px, 6vw, 64px); display: grid; gap: clamp(16px, 2vw, 24px); }
  .placas-grid { max-width: 760px; }
  @media (min-width: 560px) { .placas-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) {
    .placas .wrap { display: grid; grid-template-columns: 1fr 740px; gap: 56px; align-items: end; }
    .placas-grid { margin-top: 0; }
  }
  .foto { border-radius: var(--r-lg); overflow: hidden; position: relative; box-shadow: 0 18px 40px -18px rgb(22 0 56 / .45); }
  .foto :global(img) { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 4 / 5; }
  .foto figcaption { position: absolute; inset: auto 0 0; padding: 72px clamp(18px, 3vw, 28px) clamp(16px, 2.4vw, 24px); background: linear-gradient(transparent, rgb(22 0 56 / .9)); color: var(--white); display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .foto figcaption strong { font-size: clamp(3rem, 6vw, 4.5rem); line-height: .9; font-weight: 800; letter-spacing: -.02em; font-stretch: 125%; }
  .foto figcaption strong.hi { color: var(--glow); }
  .foto figcaption span { font-size: .875rem; color: var(--text-soft); }

  .dep { background: var(--night); }
  .dep-rail { margin-top: clamp(36px, 5vw, 56px); display: grid; grid-auto-flow: column; grid-auto-columns: min(78vw, 300px); gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 12px; scrollbar-width: thin; scrollbar-color: var(--deep) transparent; }
  @media (min-width: 1100px) { .dep-rail { grid-auto-flow: row; grid-template-columns: repeat(5, 1fr); overflow: visible; } }
  .dv { scroll-snap-align: start; border-radius: var(--r-lg); overflow: hidden; background: var(--ink); border: 1px solid var(--line); display: flex; flex-direction: column; }
  .poster { aspect-ratio: 9 / 13; background: var(--deep); position: relative; overflow: hidden; }
  .poster :global(img), .poster :global(video) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .poster::after { content: ""; position: absolute; inset: 40% 0 0; background: linear-gradient(transparent, rgb(22 0 56 / .92)); pointer-events: none; }
  .poster:has(video)::after, .poster:has(video) .big { display: none; }
  .poster .play { position: absolute; z-index: 1; top: 12px; right: 12px; width: 48px; height: 48px; border-radius: 50%; color: var(--white); background: rgb(22 0 56 / .45); border: 1px solid rgb(255 255 255 / .55);
    display: grid; place-items: center; cursor: pointer; backdrop-filter: blur(4px); transition: transform .2s var(--ease), background .2s; }
  .poster .play:hover { transform: scale(1.06); background: rgb(157 92 255 / .6); }
  .big { position: absolute; z-index: 1; left: 16px; right: 16px; bottom: 14px; font-size: 2rem; line-height: 1; font-weight: 800; letter-spacing: -.02em; font-stretch: 125%; }
  .big small { display: block; font-size: .8125rem; font-weight: 600; letter-spacing: 0; font-stretch: 100%; color: var(--text-soft); margin-top: 4px; }
  .txt { flex: 1; display: flex; flex-direction: column; justify-content: space-between; gap: 12px; padding: 16px 18px 20px; }
  .txt p { font-size: .9375rem; color: var(--text-soft); }
  .txt p :global(b) { color: var(--white); }
  .txt .who { font-size: .875rem; font-weight: 700; color: var(--lilac); }

  .time { background: var(--ink); }
  .time-grid { display: grid; gap: clamp(32px, 5vw, 64px); align-items: center; }
  @media (min-width: 900px) { .time-grid { grid-template-columns: 1fr 1fr; } }
  .time-photo { border-radius: var(--r-lg); overflow: hidden; box-shadow: 0 30px 70px -20px rgb(122 47 241 / .55); }
  .time-photo :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; object-position: 50% 20%; }
  .promise { margin-top: 28px; display: grid; gap: 14px; }
  .promise li { display: flex; gap: 14px; align-items: flex-start; }
  .promise span { flex: none; margin-top: 3px; color: var(--glow); }
  .promise p { color: var(--text-soft); }
  .promise b { color: var(--white); }

  .faq { background: var(--night); }
  .faq-grid { display: grid; gap: clamp(32px, 5vw, 64px); }
  @media (min-width: 900px) { .faq-grid { grid-template-columns: .8fr 1.2fr; } }
  details { border-bottom: 1px solid var(--line); }
  details:first-child { border-top: 1px solid var(--line); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 22px 0; min-height: 48px; font-size: 1.125rem; font-weight: 700; letter-spacing: -.01em; font-stretch: 104%; }
  summary::-webkit-details-marker { display: none; }
  summary span { flex: none; display: grid; transition: transform .3s var(--ease); color: var(--glow); }
  details[open] summary span { transform: rotate(45deg); }
  .a { padding: 0 0 22px; color: var(--text-soft); max-width: 60ch; }
  .a :global(b) { color: var(--white); }

  .close { background: radial-gradient(120% 90% at 50% 0%, var(--electric), var(--royal) 45%, var(--night) 100%); text-align: center; padding-block: clamp(80px, 12vw, 150px); }
  .close h2 { margin-inline: auto; max-width: 18ch; font-size: clamp(2.1rem, 5.4vw, 3.8rem); }
  .close h2 em { color: var(--lilac); }
  .close p { margin: 18px auto 0; max-width: 46ch; color: var(--text-soft); font-size: 1.0625rem; }
  .ctas { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }

  footer { background: #0b001f; color: #b9b0d0; font-size: .8125rem; padding-block: 32px 96px; }
  @media (min-width: 980px) { footer { padding-bottom: 32px; } }
  footer .wrap { display: flex; flex-wrap: wrap; gap: 16px 24px; justify-content: space-between; align-items: center; }
  footer :global(img) { width: 96px; }
  footer a { color: var(--white); }

  .dock { position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 20; display: none; transform: translateY(140%); transition: transform .4s var(--ease); }
  .dock.show { transform: none; }
  @media (max-width: 979px) { .dock { display: block; } }
  .dock .btn { width: 100%; box-shadow: 0 12px 32px -6px rgb(0 0 0 / .6), 0 10px 28px -8px rgb(157 92 255 / .7); }
</style>

<script>
  const dock = document.getElementById('dock')!;
  const quiz = document.getElementById('quiz')!;
  const done = () => quiz.querySelector('[data-step="5"].on') !== null;
  new IntersectionObserver(([en]) => dock.classList.toggle('show', !en.isIntersecting && !done()), { threshold: 0 }).observe(quiz);
  dock.querySelector('a')!.addEventListener('click', (e) => {
    e.preventDefault();
    quiz.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    quiz.querySelector<HTMLElement>('.step.on [role=radio], .step.on input')?.focus({ preventScroll: true });
  });
</script>
