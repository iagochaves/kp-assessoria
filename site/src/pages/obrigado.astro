---
import { getImage } from 'astro:assets';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import logo from '../assets/kp-monogram-white.png';
import vslPoster from '../assets/vsl-poster.jpg';

/** WhatsApp community link from the WordPress /obrigado page. */
const community = 'https://chat.whatsapp.com/BVVx0Efphb8AchpojshEGp';
const poster = await getImage({ src: vslPoster, width: 1280, format: 'webp' });
const check = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>';
---
<Base
  title="Cadastro concluído · KP Assessoria"
  description="Recebemos seu diagnóstico. Assista ao vídeo e entre na comunidade da KP Assessoria."
  noindex
  skip={{ href: '#conteudo', label: 'Pular para o conteúdo' }}
>
  <main class="thanks" id="conteudo">
    <div class="wrap">
      <a class="logo" href="/"><Image src={logo} alt="KP Assessoria" width={124} loading="eager" /></a>

      <p class="done"><span class="tick" set:html={check} />Cadastro concluído</p>
      <h1>Assista ao vídeo <em>antes</em> de entrar na comunidade.</h1>
      <p class="lede">Em 2 minutos você entende exatamente o que acontece a partir de agora. Um especialista da KP fala com você no WhatsApp em até 8 horas úteis.</p>

      <!-- VSL without player chrome: autoplays, a click only pauses/resumes (no seeking). -->
      <div class="vsl" id="vsl" role="button" tabindex="0" aria-label="Pausar vídeo" data-state="playing">
        <video src="/video/vsl.mp4" poster={poster.src} playsinline preload="auto" disablepictureinpicture disableremoteplayback aria-hidden="true"></video>
        <span class="sound" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4z"/><path d="m23 9-6 6M17 9l6 6"/></svg>
          Toque para ativar o som
        </span>
        <span class="paused" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
      </div>

      <div class="cta">
        <a class="btn" href={community} target="_blank" rel="noopener">Entrar na comunidade agora</a>
        <p class="hint">Grupo no WhatsApp com conteúdos e avisos da KP.</p>
      </div>
    </div>
  </main>
</Base>

<style>
  .thanks { min-height: 100svh; background: var(--night); padding-block: 18px clamp(48px, 8vw, 96px); position: relative; isolation: isolate; overflow: hidden; }
  .thanks::before { content: ""; position: absolute; inset: -30% -20% auto auto; width: min(900px, 120vw); aspect-ratio: 1; z-index: -1;
    background: radial-gradient(closest-side, rgb(122 47 241 / .5), rgb(92 16 216 / .16) 55%, transparent 72%); }
  .wrap { max-width: 860px; }
  .logo { display: block; width: fit-content; }
  .logo :global(img) { width: 124px; height: auto; }
  .done { margin-top: clamp(28px, 6vw, 56px); display: inline-flex; align-items: center; gap: 10px; font-size: .875rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--glow); }
  .tick { width: 28px; height: 28px; border-radius: 50%; background: var(--glow); color: var(--white); display: grid; place-items: center; }
  h1 { margin-top: 14px; }
  .lede { margin-top: 16px; max-width: 32.1em; font-size: clamp(1.05rem, 1.6vw, 1.2rem); color: var(--text-soft); }
  .vsl { margin-top: clamp(24px, 4vw, 40px); border-radius: var(--r-lg); overflow: hidden; background: var(--deep); aspect-ratio: 16 / 9;
    border: 1px solid var(--line); box-shadow: 0 30px 60px -20px rgb(0 0 0 / .55); }
  .vsl { position: relative; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .vsl video { width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }
  .sound, .paused { position: absolute; display: none; color: var(--white); background: rgb(22 0 56 / .7); border: 1px solid rgb(255 255 255 / .4); backdrop-filter: blur(4px); }
  .sound { left: 50%; bottom: 16px; translate: -50% 0; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 999px; font-size: .875rem; font-weight: 700; white-space: nowrap; }
  .paused { inset: 50% auto auto 50%; translate: -50% -50%; width: 72px; height: 72px; border-radius: 50%; place-items: center; }
  .vsl[data-state="muted"] .sound { display: inline-flex; }
  .vsl[data-state="paused"] .paused { display: grid; }
  .cta { margin-top: 28px; display: grid; gap: 10px; justify-items: start; }
  .hint { font-size: .875rem; color: var(--text-soft); }
  @media (max-width: 560px) { .cta { justify-items: stretch; } .cta .btn { text-align: center; } }
</style>

<script>
  const box = document.getElementById('vsl')!;
  const video = box.querySelector('video')!;
  const set = (state: 'playing' | 'paused' | 'muted') => {
    box.dataset.state = state;
    box.setAttribute('aria-label', state === 'paused' ? 'Continuar vídeo' : state === 'muted' ? 'Ativar o som do vídeo' : 'Pausar vídeo');
  };

  // Browsers block autoplay with sound without a gesture on this page: try with sound, fall back to muted.
  video.play().then(() => set('playing')).catch(() => {
    video.muted = true;
    video.play().then(() => set('muted')).catch(() => set('paused'));
  });

  const toggle = () => {
    if (box.dataset.state === 'muted') {
      // First tap on a muted autoplay restarts the video with sound, so nothing is missed.
      video.muted = false;
      video.currentTime = 0;
      video.play();
      set('playing');
    } else if (video.paused) {
      video.play();
      set('playing');
    } else {
      video.pause();
      set('paused');
    }
  };
  box.addEventListener('click', toggle);
  box.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
  });
  box.addEventListener('contextmenu', (e) => e.preventDefault());
  video.addEventListener('ended', () => set('paused'));
</script>
